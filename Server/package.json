    "js-yaml": "^5.5.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.11.4",
    "nanoid": "^3.3.20",
    "nodemailer": "^10.2.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
