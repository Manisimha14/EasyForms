NODE_ENV=development
PORT=8080

MONGODB_URI=
JWT_ACCESS_SECRET=
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7
BCRYPT_COST=12
CORS_ORIGINS=http://localhost:5173

LOG_LEVEL=info
TRUST_PROXY=0

APP_VERSION=local
MONGODB_MAX_POOL_SIZE=10
RATE_LIMIT_GENERAL_MAX=300
RATE_LIMIT_PUBLIC_READ_MAX=120
RATE_LIMIT_PUBLIC_SUBMIT_MAX=20
REQUEST_TIMEOUT_MS=30000

# Transactional Email (Google SMTP or HTTPS REST API)
# Modes: 'mock' (in-memory test logger), 'smtp' (direct Nodemailer), or 'api' (Resend/Brevo HTTPS API)
EMAIL_PROVIDER=gmail
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_APP_PASSWORD=
EMAIL_FROM=
EMAIL_MODE=mock

# HTTPS Email Delivery (Recommended for Render Free Tier to bypass SMTP port blocking)
# Obtain a free key from https://resend.com or https://brevo.com
RESEND_API_KEY=
BREVO_API_KEY=

# AI Integration (Gemini with Groq Fallback)
GEMINI_API_KEY=
GROQ_API_KEY=
